# Copy to .env. Never commit .env or real credentials.
MONITOR_ENVIRONMENT=development
MONITOR_LOG_LEVEL=INFO

# Bootstrap only: creates the first account; never overwrites an existing account.
MONITOR_ADMIN_USERNAME=admin
MONITOR_ADMIN_PASSWORD=
# For production behind HTTPS, set this to true.
MONITOR_SECURE_COOKIES=false
MONITOR_SESSION_SECONDS=28800
# Optional generic JSON webhook. Treat its complete URL as a secret.
MONITOR_WEBHOOK_URL=
MONITOR_WEBHOOK_ALLOW_PRIVATE=false
# Local Python process only; Compose uses its named application-data volume.
MONITOR_DATABASE_PATH=var/monitoring.sqlite3

# Exact origins only, as JSON arrays. Empty means no new monitoring targets.
MONITOR_APPROVED_ORIGINS=[]
# Internal origins must appear in both lists; metadata/link-local IPs stay blocked.
MONITOR_PRIVATE_ORIGINS=[]
MONITOR_SCHEDULER_ENABLED=true
MONITOR_CHECK_CONCURRENCY=5
MONITOR_SERVICE_LIMIT=100
MONITOR_HISTORY_PER_SERVICE=1000

GRAFANA_ADMIN_USER=admin
# Required for Compose. Choose a password before starting the stack.
GRAFANA_ADMIN_PASSWORD=

API_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Optional demonstration target (compose.demo.yml).
DEMO_PORT=8081
